# Copy this to .env and adjust as needed
# docker-compose automatically reads .env

# Ollama model used for Stage 6 styling explanations
OLLAMA_TEXT_MODEL=mistral

# Paths inside the container (don't change unless you modify docker-compose.yml volumes)
CSV_PATH=/app/data/modanisa_products.csv
QDRANT_PATH=/app/data/qdrant_storage
